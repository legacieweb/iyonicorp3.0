https://api.iyonicorp.test {
    tls internal
    reverse_proxy localhost:2823
}

https://iyonicorp.test, https://*.iyonicorp.test, https://sellermuutu.test {
    # Force Caddy to use internal self-signed local SSL certificates
    tls internal

    # Proxy all traffic to your Vite frontend server running on port 4000
    reverse_proxy localhost:4000 {
        # Modern header definitions for full proxy support
        header_up Host {header.Host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        
        # Enable WebSocket connections (Crucial for Vite dev scripts to load)
        header_up Upgrade {header.Upgrade}
        header_up Connection {header.Connection}
    }
}
 