# Database
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/iyonicweb

# App Config
VITE_APP_NAME=ShopRight
PORT=2823
VITE_APP_URL=https://iyonicorp.com
VITE_API_URL=https://api.iyonicorp.com/api
CORS_ORIGINS=http://localhost:4000,https://iyonicorp.com,https://www.iyonicorp.com
# Production frontend build argument; do not use the localhost VITE_API_URL here.
FRONTEND_API_URL=https://api.iyonicorp.com/api
VITE_ADMIN_EMAIL=your-admin-email@example.com
VITE_ADMIN_PASSWORD=your_admin_password

# Security
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# Email (Gmail SMTP)
# For Gmail: enable 2FA, then generate a 16-char App Password
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_16_char_app_password_here

# Paystack (test mode)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_key_here
PAYSTACK_SECRET_KEY=sk_test_your_key_here
